---
// Tab panel: a page section under the tab bar, headed like a Vista dialog's
// main instruction. CSS shows only the selected panel; see the data-tab rules
// in global.css. The tab strip script adds the tabpanel role, so without
// JavaScript the panels are plain sections, separated by a rule.
interface Props {
  tabKey: string;
  title: string;
}

const { tabKey, title } = Astro.props;
---

<section
  class="aero-panel relative no-js:not-first:border-t no-js:not-first:border-dotted no-js:not-first:border-rule no-js:not-first:pt-4"
  id={`p-${tabKey}`}
>
  <h2 class="mb-2 px-0.5 font-head text-lg leading-tight text-heading text-shadow-[0_1px_0_#fff]">
    {title}
  </h2>
  <slot />
</section>
