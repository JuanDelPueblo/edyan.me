---
import { portfolio as info } from "../content";
import ContactOrbs from "./ContactOrbs.astro";

// Hero design C: a centred title over the scene, like a logo on a desktop
// wallpaper, with a one-line tagline and the links in one row.
const [beforeWave, afterWave] = info.greeting.split("👋");
const hasWave = info.greeting.includes("👋");
---

<!--
  .aero-banner sets the header's height and keeps its content in the sky,
  above the horizon. The waterline is the header's bottom edge.
-->
<header class="aero-banner relative mb-12 flex items-center justify-center px-3 text-center max-sm:mb-10 max-sm:px-0.5">
  <div class="relative z-1 grid min-w-0 justify-items-center gap-3 max-sm:gap-2.5">
    <div class="flex items-center gap-3">
      <div
        class="aero-orb relative grid size-16 flex-none place-items-center rounded-full font-head text-2xl font-bold max-sm:size-12 max-sm:text-lg"
        aria-hidden="true"
      >
        {info.avatar ? (
          <img
            class="absolute inset-0 size-full rounded-full object-cover"
            src={info.avatar}
            alt=""
          />
        ) : (
          <span class="relative z-2">{info.monogram}</span>
        )}
      </div>
      <p class="aero-greet rounded-[14px] px-3.5 py-[3px] font-head text-sm font-bold">
        {hasWave ? (
          <>
            {beforeWave}
            <span class="aero-wave">👋</span>
            {afterWave}
          </>
        ) : (
          info.greeting
        )}
      </p>
    </div>
    <h1 class="aero-title relative font-head text-[56px] leading-[1.05] font-bold text-balance max-sm:text-[34px]">
      {info.title}
    </h1>
    <p class="aero-glass-card rounded-full px-4 py-1 font-head text-sm font-bold text-heading max-sm:rounded-xl max-sm:text-[13px]">
      {info.tagline}
    </p>
    <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2.5">
      <a
        class="aero-leaf aero-glow aero-jelly relative inline-flex items-center justify-center rounded-[20px] px-[22px] py-[9px] font-head text-sm font-bold no-underline"
        href={info.resume}
      >
        View Resume
      </a>
      <ContactOrbs />
    </div>
  </div>
</header>

<script>
  import "../scripts/waterline";
</script>
