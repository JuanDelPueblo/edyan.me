---
// Shared SVG definitions: gradients and the icon symbols that other
// components reference with <use href="#i-...">.
---

<svg width="0" height="0" class="absolute" aria-hidden="true">
  <defs>
    <!-- Clock: brushed rim, pale glass face, top gloss. -->
    <linearGradient id="ck-rim" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset=".45" stop-color="#b9cfe0"></stop>
      <stop offset=".55" stop-color="#7f9db6"></stop>
      <stop offset="1" stop-color="#d7e6f2"></stop>
    </linearGradient>
    <radialGradient id="ck-face" cx=".5" cy=".6" r=".6">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset=".75" stop-color="#eef7fd"></stop>
      <stop offset="1" stop-color="#bcdcf2"></stop>
    </radialGradient>
    <linearGradient id="ck-gloss" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".85"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </linearGradient>

    <!-- Placeholder thumbnail: sky and hills. -->
    <linearGradient id="ph-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3d9cf0"></stop>
      <stop offset="1" stop-color="#c4ebff"></stop>
    </linearGradient>
    <linearGradient id="ph-hill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#a6ec5c"></stop>
      <stop offset="1" stop-color="#2f8c0e"></stop>
    </linearGradient>

    <!-- Full-colour glossy icons. -->
    <linearGradient id="gf-back" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f9c843"></stop>
      <stop offset="1" stop-color="#d9940c"></stop>
    </linearGradient>
    <linearGradient id="gf-front" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffe993"></stop>
      <stop offset=".5" stop-color="#fbc93c"></stop>
      <stop offset="1" stop-color="#e49d0c"></stop>
    </linearGradient>
    <linearGradient id="gb-body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d08e52"></stop>
      <stop offset=".55" stop-color="#a5622c"></stop>
      <stop offset="1" stop-color="#7a4318"></stop>
    </linearGradient>
    <linearGradient id="gb-clasp" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff6b0"></stop>
      <stop offset="1" stop-color="#d4a40c"></stop>
    </linearGradient>
    <linearGradient id="ge-paper" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset="1" stop-color="#d9e6f1"></stop>
    </linearGradient>
    <symbol id="i-folder" viewBox="0 0 32 32">
      <path
        d="M2.5 9.5a2 2 0 0 1 2-2h7.2l2.6 2.6h13.2a2 2 0 0 1 2 2V25a2 2 0 0 1-2 2H4.5a2 2 0 0 1-2-2z"
        fill="url(#gf-back)"
        stroke="#a86b00"
        stroke-width=".8"
      ></path>
      <rect
        x="5.5"
        y="11"
        width="21"
        height="10"
        rx="1"
        fill="#fff"
        stroke="#9fb6c8"
        stroke-width=".6"
      ></rect>
      <path d="M7.5 13.5h14M7.5 16h11" stroke="#7fb6e0" stroke-width="1"></path>
      <path
        d="M2.5 15a2 2 0 0 1 2-2h23a2 2 0 0 1 2 2V25a2 2 0 0 1-2 2H4.5a2 2 0 0 1-2-2z"
        fill="url(#gf-front)"
        stroke="#a86b00"
        stroke-width=".8"
      ></path>
      <path
        d="M3.5 15.2a1.6 1.6 0 0 1 1.6-1.4h21.8a1.6 1.6 0 0 1 1.6 1.4V19.5H3.5z"
        fill="#fff"
        opacity=".45"
      ></path>
    </symbol>
    <symbol id="i-briefcase" viewBox="0 0 32 32">
      <rect
        x="11"
        y="4.5"
        width="10"
        height="5.5"
        rx="2"
        fill="none"
        stroke="#5a3210"
        stroke-width="2.2"
      ></rect>
      <rect
        x="2.5"
        y="8.5"
        width="27"
        height="19"
        rx="3"
        fill="url(#gb-body)"
        stroke="#5a3210"
        stroke-width=".9"
      ></rect>
      <path
        d="M2.5 15.5h27"
        stroke="#5a3210"
        stroke-width="1"
        opacity=".55"
      ></path>
      <rect
        x="13.5"
        y="13.2"
        width="5"
        height="4.6"
        rx="1"
        fill="url(#gb-clasp)"
        stroke="#8a6a10"
        stroke-width=".6"
      ></rect>
      <path
        d="M3.5 11.5a2.5 2.5 0 0 1 2.5-2h20a2.5 2.5 0 0 1 2.5 2V14.5h-25z"
        fill="#fff"
        opacity=".35"
      ></path>
    </symbol>
    <symbol id="i-envelope" viewBox="0 0 32 32">
      <rect
        x="2.5"
        y="7"
        width="27"
        height="19"
        rx="2"
        fill="url(#ge-paper)"
        stroke="#6f86a0"
        stroke-width=".8"
      ></rect>
      <path
        d="M3 25.5l10-8.5M29 25.5l-10-8.5"
        stroke="#b5c6d6"
        stroke-width="1"
      ></path>
      <path
        d="M3 8l13 10 13-10"
        fill="none"
        stroke="#7d97b0"
        stroke-width="1.3"
      ></path>
      <rect
        x="22"
        y="9.5"
        width="5"
        height="5.5"
        fill="#e0402a"
        stroke="#fff"
        stroke-width=".8"
      ></rect>
      <path d="M3 8h26v5.5H3z" fill="#fff" opacity=".35"></path>
    </symbol>
    <!-- Brand glyphs from Simple Icons (CC0); LinkedIn reduced to its letters. -->
