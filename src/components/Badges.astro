---
import { portfolio as info } from "../content";
---

<!--
  80x15 "antipixel" badges, shown at 2x with crisp pixels. Linked badges get a
  balloon with their destination like other links.
-->
<ul class="mt-0.5 flex flex-wrap justify-center gap-2" aria-label="Site badges">
  {info.badges.map((badge) => {
    const image = (
      <img
        class="block h-[30px] w-40 [image-rendering:pixelated]"
        src={badge.image}
        alt={badge.alt}
        width="80"
        height="15"
        loading="lazy"
        decoding="async"
      />
    );
    return (
      <li class="aero-badge">
        {badge.url ? (
          <a class="block" href={badge.url}>
            {image}
          </a>
        ) : (
          image
        )}
      </li>
    );
  })}
</ul>
