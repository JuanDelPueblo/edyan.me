---
import { portfolio as info } from "../content";

// The greeting's wave emoji gets its own span so it can wave.
const [beforeWave, afterWave] = info.greeting.split("👋");
const hasWave = info.greeting.includes("👋");
---

<header class="aero-banner relative flex min-h-[200px] items-center gap-6 px-3 pt-3.5 pb-[34px] max-sm:items-start max-sm:gap-3.5 max-sm:px-0.5 max-sm:pt-1.5 max-sm:pb-[30px]">
  <div
    class="aero-orb relative z-1 grid size-[108px] flex-none place-items-center rounded-full font-head text-[38px] font-bold max-sm:size-16 max-sm:text-[22px]"
    aria-hidden="true"
  >
    {info.avatar ? (
      <img
        class="absolute inset-0 size-full rounded-full object-cover"
        src={info.avatar}
        alt=""
      />
    ) : (
      <span class="relative z-2">{info.monogram}</span>
    )}
  </div>
  <div class="relative z-1 grid min-w-0 flex-auto justify-items-start gap-2.5">
    <p class="aero-leaf rounded-[14px] px-3.5 py-[3px] font-head text-sm font-bold">
      {hasWave ? (
        <>
          {beforeWave}
          <span class="aero-wave">👋</span>
          {afterWave}
        </>
      ) : (
        info.greeting
      )}
    </p>
    <h1 class="aero-title relative font-head text-[42px] leading-[1.1] font-bold text-balance max-sm:text-[30px]">
      {info.title}
    </h1>
    <p class="aero-glass-card max-w-[34rem] rounded-xl px-3.5 py-2 text-[13px] leading-[1.55]">
      {info.introduction}
    </p>
    <p>
      <a
        class="aero-leaf aero-glow aero-jelly relative inline-flex items-center justify-center rounded-[20px] px-[22px] py-[9px] font-head text-sm font-bold no-underline"
        href={info.resume}
      >
        View Resume
      </a>
    </p>
  </div>
</header>
<!-- Filled by the script with a decorative copy of the header. -->
<div
  class="aero-reflection pointer-events-none relative h-[140px] overflow-hidden max-sm:h-24"
  aria-hidden="true"
  inert
></div>

<script>
  // Water reflection: a copy of the header without ids, flipped by CSS.
  const banner = document.querySelector(".aero-banner")!;
  const reflection = document.querySelector(".aero-reflection")!;
  const copy = document.createElement("div");
  copy.className = banner.className + " absolute inset-x-0 top-0";
  copy.innerHTML = banner.innerHTML;
  copy.querySelectorAll("[id]").forEach((el) => el.removeAttribute("id"));
  reflection.append(copy);

  // Keep the waterline at the header's bottom edge, which moves with text
  // wrapping and font loading.
  const site = document.querySelector<HTMLElement>(".aero-site")!;
  function placeWaterline() {
    const wl =
      banner.getBoundingClientRect().bottom - site.getBoundingClientRect().top;
    site.style.setProperty("--wl", Math.round(wl) + "px");
  }
  placeWaterline();
  new ResizeObserver(placeWaterline).observe(site);
  document.fonts?.ready.then(placeWaterline);
</script>
