---
import type { Experience } from "../content";

interface Props {
  experience: Experience;
}

const { position, company, period, accomplishments, technologies } =
  Astro.props.experience;
---

<!-- data-tech lets a toolbox chip find the entries that use it. -->
<article
  class="aero-entry relative -mx-2 block rounded-lg px-2.5 py-3"
  data-tech={technologies.join("|")}
>
  <h3 class="mb-1 font-head text-base font-bold text-heading">{position}</h3>
  <p class="mb-1.5 text-[11px] text-ink-soft">
    {company} · {period}
  </p>
  <!-- Render the accomplishments list as bullet points. -->
  {accomplishments.length > 0 && (
    <ul class="mt-1 mb-1.5 list-disc pl-[18px]">
      {accomplishments.map((accomplishment) => (
        <li>{accomplishment}</li>
      ))}
    </ul>
  )}
  {technologies.length > 0 && (
    <p class="text-[11px] text-ink-soft">
      <b>Technologies:</b> {technologies.join(", ")}
    </p>
  )}
</article>
