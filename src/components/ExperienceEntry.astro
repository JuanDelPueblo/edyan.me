---
import type { Experience } from "../content";

interface Props {
  experience: Experience;
}

const { position, company, period, accomplishments, technologies } =
  Astro.props.experience;
---

<article class="my-10">
  <h3 class="my-4 text-xl font-bold leading-tight">{position}</h3>
  <p class="my-4">
    {company} · {period}
  </p>
  <!-- Render the accomplishments list as bullet points. -->
  {accomplishments.length > 0 && (
    <ul class="my-4 list-disc pl-10">
      {accomplishments.map((accomplishment) => (
        <li>{accomplishment}</li>
      ))}
    </ul>
  )}
  {technologies.length > 0 && (
    <p class="my-4">Technologies: {technologies.join(", ")}</p>
  )}
</article>
