---
import { portfolio as info } from "../content";
import Clock from "./Clock.astro";

// Notification area at the right end of the tab strip: a sound toggle, a
// toggle for the LCD screen texture (.aero-screen in global.css) and a
// clock in the configured time zone that opens a flyout. The flyout shows the
// build date as the last-updated date.
const zoned = (options: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat("en-US", { timeZone: info.timeZone, ...options });
const updated = zoned({
  month: "long",
  day: "numeric",
  year: "numeric",
}).format(new Date());
const zoneName = zoned({ timeZoneName: "short" })
  .formatToParts(new Date())
  .find((part) => part.type === "timeZoneName")?.value;
---

<!-- The negative top margin matches the strip's top padding, so the widget
     centres in the whole strip rather than beside the tabs. -->
<div class="aero-tray -mt-2.5 max-sm:-mt-2 flex flex-none items-center gap-0.5 self-center rounded-[14px] p-0.5 font-head text-xs font-bold tabular-nums no-js:hidden">
  <button
    class="aero-tray-btn flex min-h-[26px] cursor-pointer items-center rounded-xl px-[5px] py-px"
    id="sound"
    type="button"
    aria-pressed="false"
    aria-label="Sound effects"
    data-tip-title="Sound effects"
    data-tip-body="Off"
  >
    <!-- Speaker: waves when on, a red mute badge when off. -->
    <svg class="size-5 drop-shadow-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M3 9h3.8l5-4.2v14.4l-5-4.2H3z"
        fill="url(#ck-rim)"
        stroke="#2d4f6e"
        stroke-width="1.1"
        stroke-linejoin="round"
      ></path>
      <g
        class="spk-on"
        fill="none"
        stroke="#1a86c8"
        stroke-width="1.9"
        stroke-linecap="round"
      >
        <path d="M15 8.8a4.4 4.4 0 0 1 0 6.4"></path>
        <path d="M17.8 6.2a8.2 8.2 0 0 1 0 11.6"></path>
      </g>
      <g class="spk-off">
        <circle
          cx="17.4"
          cy="15.6"
          r="4.7"
          fill="#e0402a"
          stroke="#fff"
        ></circle>
        <path
          d="M15.2 13.4l4.4 4.4"
          stroke="#fff"
          stroke-width="1.7"
          stroke-linecap="round"
        ></path>
      </g>
    </svg>
  </button>
  <button
    class="aero-tray-btn flex min-h-[26px] cursor-pointer items-center rounded-xl px-[5px] py-px max-sm:hidden"
    id="screen-filter"
    type="button"
    aria-pressed="true"
    aria-label="Screen filter"
    data-tip-title="Screen filter"
    data-tip-body="On"
  >
    <!-- Monitor: RGB subpixel bars on a lit screen when on, a dark screen
         when off. -->
    <svg class="size-5 drop-shadow-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M10.5 17.5h3l.8 2.7H9.7zM7.5 20.5h9"
        fill="url(#ck-rim)"
        stroke="#2d4f6e"
        stroke-width="1.1"
        stroke-linejoin="round"
        stroke-linecap="round"
      ></path>
      <rect
        x="2.5"
        y="3.5"
        width="19"
        height="14"
        rx="2"
        fill="url(#ck-rim)"
        stroke="#2d4f6e"
        stroke-width="1.1"
      ></rect>
      <g class="scr-on">
        <rect
          x="4.5"
          y="5.5"
          width="15"
          height="10"
          rx="0.8"
          fill="#2f9fe0"
        ></rect>
        <path d="M9.6 7.5v6" stroke="#ff6a5a" stroke-width="1.6"></path>
        <path d="M12 7.5v6" stroke="#6fe07a" stroke-width="1.6"></path>
        <path d="M14.4 7.5v6" stroke="#9fc4ff" stroke-width="1.6"></path>
      </g>
      <g class="scr-off">
        <rect
          x="4.5"
          y="5.5"
          width="15"
          height="10"
          rx="0.8"
          fill="#3b5168"
        ></rect>
        <path
          d="M6 13.5l6-6.5"
          stroke="#fff"
          stroke-opacity=".3"
          stroke-width="1.2"
          stroke-linecap="round"
        ></path>
      </g>
    </svg>
  </button>
  <button
    class="aero-tray-btn flex min-h-[26px] cursor-pointer items-center gap-1.5 rounded-xl py-px pr-[9px] pl-[3px] max-sm:pr-[3px]"
    id="tray-clock"
    type="button"
    data-time-zone={info.timeZone}
    popovertarget="clock-flyout"
  >
    <!-- 3px of padding keeps the 20px face concentric with the rounded end of
         the 26px-tall hover highlight. -->
    <Clock class="mini-clock size-5 drop-shadow-icon" />
    <span class="sr-only">{info.clockPlace} time: </span>
    <!-- Narrow screens show only the clock face; screen readers still get the time. -->
    <span class="tray-time max-sm:sr-only"></span>
  </button>
</div>

<div
  class="aero-flyout fixed inset-auto m-0 w-[228px] rounded-[10px] px-3.5 pt-3.5 pb-3 text-center text-xs leading-normal"
  id="clock-flyout"
  popover
  role="dialog"
  aria-label="Clock"
>
  <Clock
    class="big-clock mx-auto mb-2 block size-[132px] drop-shadow-[0_4px_6px_rgba(0,40,90,0.3)]"
    big
  />
  <p class="fly-time font-head text-xl font-bold text-heading tabular-nums text-shadow-[0_1px_0_#fff]"></p>
  <p class="fly-date"></p>
  <p class="text-[11px] text-ink-soft">
    {info.clockPlace} ({zoneName})
  </p>
  <p class="mt-2.5 border-t border-dotted border-rule pt-2 text-[11px] text-balance text-ink-soft">
    Site last updated {updated}
  </p>
</div>

<script>
  import { isSoundOn, setSoundOn, sfx } from "../scripts/sound";

  // Sound toggle. The choice is remembered per browser.
  const soundBtn = document.getElementById("sound")!;
  function showSound(on: boolean) {
    setSoundOn(on);
    soundBtn.setAttribute("aria-pressed", String(on));
    soundBtn.dataset.tipBody = on ? "On" : "Off";
    try {
      localStorage.setItem("aero-sound", on ? "on" : "off");
    } catch {
      // Storage can be blocked; the toggle still works for this visit.
    }
  }
  try {
    if (localStorage.getItem("aero-sound") === "on") showSound(true);
  } catch {
    // Without storage, sound starts off.
  }
  soundBtn.addEventListener("click", () => {
    if (isSoundOn()) {
      sfx("off");
      showSound(false);
    } else {
      showSound(true);
      sfx("on");
    }
  });
  // Screen filter toggle. The inline script in Layout.astro applies a saved
  // "off" before first paint.
  const screenBtn = document.getElementById("screen-filter")!;
  const html = document.documentElement;
  function showScreen(on: boolean) {
    screenBtn.setAttribute("aria-pressed", String(on));
    screenBtn.dataset.tipBody = on ? "On" : "Off";
    if (on) delete html.dataset.screen;
    else html.dataset.screen = "off";
  }
  showScreen(html.dataset.screen !== "off");
  screenBtn.addEventListener("click", () => {
    const on = html.dataset.screen === "off";
    showScreen(on);
    sfx("click");
    try {
      localStorage.setItem("aero-screen", on ? "on" : "off");
    } catch {
      // Storage can be blocked; the toggle still works for this visit.
    }
  });

  // A glassy click for buttons and links across the page.
  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    if (target.closest(".aero-pill, a.aero-leaf, .aero-contact, .aero-badge a"))
      sfx("click");
  });

  // Clock: hands and times in the configured time zone, updated each second.
  const trayClock = document.getElementById("tray-clock")!;
  const trayTime = trayClock.querySelector(".tray-time")!;
  const flyout = document.getElementById("clock-flyout")!;
  const timeZone = trayClock.dataset.timeZone;
  const zoned = (options: Intl.DateTimeFormatOptions) =>
    new Intl.DateTimeFormat("en-US", { timeZone, ...options });
  const clockParts = zoned({
    hour: "numeric",
    minute: "numeric",
    second: "numeric",
    hourCycle: "h23",
  });
  const shortTime = zoned({ hour: "numeric", minute: "2-digit" });
  const longTime = zoned({
    hour: "numeric",
    minute: "2-digit",
    second: "2-digit",
  });
  const longDate = zoned({
    weekday: "long",
    month: "long",
    day: "numeric",
    year: "numeric",
  });
  function tick() {
    const now = new Date();
    const t: Record<string, number> = {};
    for (const part of clockParts.formatToParts(now))
      t[part.type] = +part.value;
    for (const svg of document.querySelectorAll(".mini-clock, .big-clock")) {
      const turn = (hand: string, deg: number) =>
        svg
          .querySelector(hand)
          ?.setAttribute("transform", `rotate(${deg} 50 50)`);
      turn(".h-hr", (t.hour % 12) * 30 + t.minute * 0.5);
      turn(".h-min", t.minute * 6 + t.second * 0.1);
      turn(".h-sec", t.second * 6);
    }
    const short = shortTime.format(now);
    if (trayTime.textContent !== short) trayTime.textContent = short;
    flyout.querySelector(".fly-time")!.textContent = longTime.format(now);
    flyout.querySelector(".fly-date")!.textContent = longDate.format(now);
  }
  tick();
  setInterval(tick, 1000);

  // Place the flyout under the clock button, right-aligned, inside the window
  // and clear of notches (--safe-* in global.css).
  function placeFlyout() {
    const r = trayClock.getBoundingClientRect();
    const w = parseFloat(getComputedStyle(flyout).width);
    const root = getComputedStyle(document.documentElement);
    const left = 12 + (parseFloat(root.getPropertyValue("--safe-left")) || 0);
    const right = 12 + (parseFloat(root.getPropertyValue("--safe-right")) || 0);
    flyout.style.top = r.bottom + 8 + "px";
    flyout.style.left =
      Math.max(left, Math.min(r.right - w, innerWidth - w - right)) + "px";
  }
  flyout.addEventListener("beforetoggle", (e) => {
    if ((e as ToggleEvent).newState !== "open") {
      sfx("close");
      return;
    }
    placeFlyout();
    sfx("open");
  });
  const followFlyout = () => flyout.matches(":popover-open") && placeFlyout();
  addEventListener("scroll", followFlyout, { passive: true });
  addEventListener("resize", followFlyout);
</script>
