---
import { portfolio as info } from "../content";

// Round contact buttons for the header. Tile colour class and icon for each
// known contact name, as in ContactList.astro; other names get the email look.
const looks: Record<string, [string, string]> = {
  Email: ["tile-email", "envelope"],
  GitHub: ["tile-github", "github"],
  LinkedIn: ["tile-linkedin", "linkedin"],
  Discord: ["tile-discord", "discord"],
};
---

<ul class="flex flex-wrap items-center gap-2" aria-label="Contact">
  {info.contacts.map((contact) => {
    const [tile, icon] = looks[contact.name] ?? looks.Email;
    // The envelope is a full-colour icon; brand glyphs are white.
    const glyph =
      icon === "envelope"
        ? "size-[22px] drop-shadow-icon"
        : "size-[17px] fill-white drop-shadow-brand";
    return (
      <li>
        <a
          class:list={[
            "aero-tile aero-tile-round aero-jelly relative grid size-9 place-items-center rounded-full",
            tile,
          ]}
          href={contact.url}
          aria-label={contact.name}
        >
          <svg class:list={["relative", glyph]} aria-hidden="true">
            <use href={`#i-${icon}`} />
          </svg>
        </a>
      </li>
    );
  })}
</ul>
