---
import { Font } from "astro:assets";
import "../styles/global.css";
import Icons from "../components/Icons.astro";

// Shared document layout with page-specific metadata.
interface Props {
  title: string;
  description: string;
  // The 404 page sets this to stay out of search results and link previews.
  notFound?: boolean;
}

const { title, description, notFound = false } = Astro.props;
// Absolute URL of this page, from `site` in astro.config.mjs.
const url = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en" class="bg-water-deep font-text text-ink wrap-break-word">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <!-- Files in public/ are served at fixed URLs. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    {notFound ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={url} />
        <!-- Link previews on social sites and chat apps. -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta name="twitter:card" content="summary" />
      </>
    )}
    <!-- Self-hosted Silkscreen from the fonts config in astro.config.mjs. -->
    <Font cssVariable="--font-silkscreen" preload />
    <!--
      Runs before first paint: picks the tab from the URL hash so only that
      panel renders, and applies a saved "screen filter off" choice. Without
      JavaScript, every panel shows.
    -->
    <script is:inline>
      const tabKeys = ["projects", "experiences", "contact"];
      const hashKey = location.hash.slice(1);
      document.documentElement.dataset.tab = tabKeys.includes(hashKey)
        ? hashKey
        : "projects";
      try {
        if (localStorage.getItem("aero-screen") === "off")
          document.documentElement.dataset.screen = "off";
      } catch {
        // Storage can be blocked; the filter stays on.
      }
      // Exact device pixel size for the .aero-screen texture. Zooming changes
      // devicePixelRatio, which ends the current resolution query.
      const setDpx = () => {
        document.documentElement.style.setProperty(
          "--dpx",
          1 / devicePixelRatio + "px",
        );
        matchMedia(`(resolution: ${devicePixelRatio}dppx)`).addEventListener(
          "change",
          setDpx,
          { once: true },
        );
      };
      setDpx();
    </script>
  </head>
  <body class="m-0">
    <Icons />
    <a
      class="absolute -top-20 left-4 z-60 rounded bg-white p-2 text-link underline focus:top-[max(8px,env(safe-area-inset-top))]"
      href="#main-content"
    >
      Skip to content
    </a>
    <!-- The page content goes in this slot. -->
    <slot />
    <!-- LCD screen texture over everything; see .aero-screen in global.css. -->
    <div class="aero-screen-blur" aria-hidden="true"></div>
    <div class="aero-screen" aria-hidden="true"></div>
  </body>
</html>
